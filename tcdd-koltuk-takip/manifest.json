{
  "manifest_version": 3,
  "name": "TCDD Koltuk Takip",
  "version": "1.1.0",
  "description": "Açık TCDD seferini sonraki tarihe geçip tekrar eski tarihe dönerek yeniler; normal koltukları izler.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting", "notifications", "offscreen"],
  "host_permissions": ["https://ebilet.tcddtasimacilik.gov.tr/*", "https://api.telegram.org/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "TCDD Koltuk Takip"},
  "icons": {"128": "icon.png"},
  "content_scripts": [
    {"matches": ["https://ebilet.tcddtasimacilik.gov.tr/*"], "js": ["page-access.js", "resume.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://ebilet.tcddtasimacilik.gov.tr/*"], "js": ["page-ready.js"], "run_at": "document_idle"}
  ]
}
